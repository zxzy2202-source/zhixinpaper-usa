# Zhixin Paper environment variables
# Copy this file to .env.local and replace examples with real values.

# Database: Turso/libSQL in hosted environments, or a local SQLite file.
TURSO_DATABASE_URL=file:./data/zhixinpaper.db
TURSO_AUTH_TOKEN=

# Admin session signing. Use a long random value in production.
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
# NEXTAUTH_SECRET is accepted as a legacy fallback.
NEXTAUTH_SECRET=

# Cloudflare R2 media storage used by the admin media library.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
NEXT_PUBLIC_R2_URL=

# Inquiry notifications. At least one sales notification channel is recommended.
SERVERCHAN_SENDKEY=
RESEND_API_KEY=
NOTIFY_EMAIL_TO=Sales@zxpapers.com
NOTIFY_EMAIL_FROM=Zhixin Paper Website <noreply@zhixinpaper.com>

# Sitemap health monitoring. The cron caller must send Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=replace-with-a-long-random-secret
# Alerts reuse SERVERCHAN_SENDKEY and/or RESEND_API_KEY. These email values can override inquiry recipients.
SITEMAP_ALERT_EMAIL_TO=
SITEMAP_ALERT_EMAIL_FROM=

# Public URL used for canonical URLs and sitemap entries.
NEXT_PUBLIC_SITE_URL=https://www.zhixinpaper.com

# Optional Feishu knowledge-base reader used by the local script.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_WIKI_TOKEN=
